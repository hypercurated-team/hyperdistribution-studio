  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
