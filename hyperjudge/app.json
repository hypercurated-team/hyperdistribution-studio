{
  "expo": {
    "name": "HyperJudge",
    "slug": "hyperjudge",
    "scheme": "hyperjudge",
    "version": "1.0.0",
    "owner": "kraftxworks",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D1A",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.kraftxworks.hyperjudge",
      "appleTeamId": "J7ZVMZND97",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": { "NSSupportsLiveActivities": true },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.kraftxworks.hyperjudge"]
      }
    },
    "plugins": [
      "@bacons/apple-targets",
      ["expo-build-properties", { "ios": { "deploymentTarget": "17.0" } }]
    ],
    "extra": { "eas": { "projectId": "1a48172d-b7a9-4e3d-8db9-23b54b07afc8" } }
  }
}
